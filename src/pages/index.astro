---
import Main from "@/UI/Main";
import Layout from "@/layouts/Layout.astro";
import { getEntries } from "@/lib/contentful";

const itemsProductos = await getEntries("producto");
const itemsColecciones = await getEntries("coleccion");
const productos = itemsProductos.map((item: any) => ({
  id: item.sys.id,
  nombre: item.fields.nombre,
  precio: item.fields.precio,
  imagenPrincipal: "https:" + item.fields.imagenPrincipal.fields.file.url,
  centimetros: item.fields.centimetros,
  tags: item.fields.tags ?? [],
  coleccion: item.fields.coleccion?.fields.nombre ?? null,
  slug: item.fields.slug,
  customizations: {
    color:
      item.fields.color?.map((colorItem: any) => ({
        nombre: colorItem.fields.nombre,
        codigo: colorItem.fields.codigo,
        codigoHex: colorItem.fields.codigoHexa,
      })) ?? [],
  },
}));
const colecciones = itemsColecciones.map((item: any) => ({
  id: item.sys.id,
  nombre: item.fields.nombre,
  subtitulo: item.fields.subtitulo,
  imagen: "https:" + item.fields.imagen.fields.file.url,
  destacado: item.fields.destacado ?? false,
  posicion: item.fields.posicion,
}));
---

<Layout>
  <Main productos={productos} colecciones={colecciones} client:load />
</Layout>
