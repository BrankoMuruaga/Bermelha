---
import Main from "@/UI/Main";
import { PRODUCTO_SELECT_FIELDS } from "@/data/config";
import Layout from "@/layouts/Layout.astro";
import { getEntries } from "@/lib/contentful";
import { mapContentfulProducto } from "@/utils/utils";

const [itemsProductos, itemsColecciones] = await Promise.all([
  getEntries("producto", {
    select: PRODUCTO_SELECT_FIELDS,
  }),
  getEntries("coleccion", {
    select:
      "sys.id,fields.nombre,fields.subtitulo,fields.imagen,fields.destacado,fields.posicion",
  }),
]);
const productos = itemsProductos.map(mapContentfulProducto);
const colecciones = itemsColecciones.map((item: any) => ({
  id: item.sys.id,
  nombre: item.fields.nombre,
  subtitulo: item.fields.subtitulo,
  imagen: "https:" + item.fields.imagen.fields.file.url,
  destacado: item.fields.destacado ?? false,
  posicion: item.fields.posicion,
}));
---

<Layout>
  <Main productos={productos} colecciones={colecciones} client:load />
</Layout>
